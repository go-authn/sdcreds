#!/bin/ksh
#
# go-authn/bridge, with its SMTP password delivered by sdcreds.
# Install as /etc/rc.d/authn_bridge, then: rcctl enable authn_bridge
#
# sdcreds must start as root (it mounts the credentials and then drops to
# authn-bridge), so daemon_user stays root: do not set authn_bridge_user in
# rc.conf.local.
#
# Credential: /etc/credstore/authn-bridge/smtp-password, made with
#   sdcreds encrypt --name smtp-password ...
# and read by the bridge as systemd-creds:smtp-password from
# $CREDENTIALS_DIRECTORY.
#
# Host key: /etc/sdcreds/host.key, owned by root, mode 0600 (anything else is
# refused). The machine id is `sysctl hw.uuid`.
#
# There is no mount namespace on OpenBSD: while the bridge runs, the
# credentials are visible to every process, and root can read them. Killing
# sdcreds (even with SIGKILL) kills the bridge and unmounts them.

daemon="/usr/local/bin/authn-bridge"
daemon_flags="serve --config /etc/authn-bridge"
daemon_user="root"

. /etc/rc.d/rc.subr

rc_bg=YES
rc_reload=NO

rc_pre() {
	[ "${daemon_user}" = root ] || {
		echo "authn_bridge: daemon_user must be root (sdcreds drops privileges)" >&2
		return 1
	}
	/usr/local/bin/sdcreds run --check --service authn-bridge \
	    --user authn-bridge --source /etc/credstore/authn-bridge \
	    -- ${daemon} ${daemon_flags}
}

rc_start() {
	rc_exec "/usr/local/bin/sdcreds run --service authn-bridge \
	    --user authn-bridge --class ${daemon_class} \
	    --source /etc/credstore/authn-bridge -- ${daemon} ${daemon_flags}"
}

rc_cmd $1
